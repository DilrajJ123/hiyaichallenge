{
  "name": "pagevoice",
  "version": "0.1.0",
  "description": "A Chrome extension that reads hovered text and controls aloud.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:secrets": "node scripts/check-secrets.mjs --history && node scripts/check-secrets.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-extension.mjs",
    "build:extension": "npm run typecheck && node scripts/build-extension.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "type": "module",
  "dependencies": {
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^4.1.12"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
