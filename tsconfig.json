{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node", "chrome"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "shared", "extension", "tests", "vite.config.ts", "vite.extension.config.ts"]
}
